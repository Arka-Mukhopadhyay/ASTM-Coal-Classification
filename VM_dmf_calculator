import pandas as pd

def coal_analysis(M_ad, VM_ad, ASH):
    MM_ad = 1.1 * ASH
    VM_dmf = (VM_ad * 100) / (100 - (M_ad + MM_ad))
    return round(VM_dmf, 2)

